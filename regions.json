    },
    {
      "id": "palouse-good-neighbor-highsite",
      "when": { "primaryTagIn": ["puw"], "repeaterTypeIn": ["high-site"] },
      "addTags": ["geg", "alw", "psc"],
      "note": "High-site good-neighbor dual-carry (geg, alw, psc) — reserved for high-site repeaters near those borders, not everyday repeaters."
    },
    {
      "id": "palouse-good-neighbor-highsite-idaho",
